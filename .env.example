# Environment variables for NEWS FLOW.
#
# Copy this file to .env.local and fill in the values. .env.local is ignored
# by git and must never be committed.
#
# For local development, the values come from `npx supabase status` after
# `npx supabase start`.

# URL of the Supabase API.
# Local: the "API URL" from `npx supabase status`, usually http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Public (anon / publishable) key of the Supabase project.
# Local: the "anon key" or "Publishable key" from `npx supabase status`.
# This key is safe to expose to the browser; row level security decides what
# it can read. Never put the service role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of this application, without a trailing slash. Used to build
# the redirect URL after login and password reset.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Set to "true" to replace the whole application with the
# maintenance notice (components/layout/maintenance-notice.tsx).
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Optional. URL of the source code, linked as "Quellcode" in the footer.
# Defaults to the upstream repository. If you deploy a modified version, the
# AGPL-3.0 requires you to set this to the source code of your version.
NEXT_PUBLIC_SOURCE_CODE_URL=
